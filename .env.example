# Supabase — proyecto compartido "intech solution" (mismo proyecto que otras apps)
# Fuente de Verdad vive en su propio schema `fuente_verdad`, no en `public`.
# Obtén estos valores en: supabase.com > proyecto intech solution > Settings > API
# IMPORTANTE: activa "fuente_verdad" en Settings > API > Exposed schemas,
# si no, la API no expone las tablas y las consultas fallan.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NO expongas NUNCA la service_role key en el cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
